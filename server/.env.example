# 複製成 .env 使用（或執行 npm run setup 自動產生）。.env 不會進 git，千萬不要貼到公開的地方。

# --- 伺服器 ---
PORT=8787
# 只讓本機連；用 Tailscale Funnel／Cloudflare 通道時也維持 127.0.0.1 即可（通道從本機連進來）
HOST=127.0.0.1
# 來源 IP（頻率限制用）要相信誰帶來的標頭，只有三種寫法，其餘不認：
#   none（或 0／空白）直接對外或本機：只看連線本身的 IP（預設）
#   cloudflare  放在 Cloudflare Tunnel 後面：只信 CF-Connecting-IP
#   tailscale   放在 Tailscale Funnel 後面：只取 X-Forwarded-For 最右邊那一個
# 注意：不要在沒有通道時設 cloudflare／tailscale，否則任何人都能自己帶假標頭繞過鎖定
# 另外：設 cloudflare／tailscale 時 HOST 必須是 127.0.0.1（只讓本機連），否則後台拒絕啟動
TRUST_PROXY=none
# 開發模式（只在自己電腦測試時設 1）：允許 http://localhost 當前端來源。正式上線不要開
DEV=0

# --- 建立群組的暗號（必填，至少 12 個字元，否則後台拒絕啟動）：沒有這組暗號的人不能建群組 ---
GROUP_CREATE_CODE=

# --- 老闆的金鑰（只放在這裡，不會傳到任何人的手機） ---
GOOGLE_API_KEY=
# 目前 Google 金鑰限制網址時，後台代呼叫會帶這個 Referer；若改用「限制 IP」的金鑰可以清空
GOOGLE_REFERER=https://ronchc.github.io/
ANTHROPIC_API_KEY=

# --- 每位家人每天的次數上限 ---
CLAUDE_DAILY_LIMIT=50
# 其中 Opus（較貴）另外限制：每位每天最多幾次（也會計入上面的總次數）
CLAUDE_OPUS_DAILY_LIMIT=20
GOOGLE_DAILY_LIMIT=500
# 允許代轉的 Claude 模型（逗號分隔）
ALLOWED_CLAUDE_MODELS=claude-opus-5-5,claude-haiku-5-5,claude-sonnet-5-5
# 單次請求 max_tokens 上限（App 必須帶 max_tokens，超過就拒絕）
CLAUDE_MAX_TOKENS=16000
# 允許轉送的 anthropic-beta 值（逗號分隔，其餘丟掉）
ALLOWED_CLAUDE_BETAS=server-side-fallback-2026-07-01

# --- 推播（Web Push）：npm run setup 會自動產生 ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 推播服務要求的聯絡方式，填你的信箱：mailto:你的信箱
VAPID_SUBJECT=mailto:admin@example.com

# --- 群組 ---
# 群組幾小時後自動到期並刪除全部資料（預設 168 = 7 天）
GROUP_TTL_HOURS=168
MAX_MEMBERS=30
MAX_PHOTO_BYTES=2097152

# --- 進階（通常不用改）---
# 額外允許的前端網址（完整 origin，逗號分隔）。預設只有 https://ronchc.github.io（http://localhost:* 要設 DEV=1 才允許）
EXTRA_ORIGINS=
# DATA_DIR=
